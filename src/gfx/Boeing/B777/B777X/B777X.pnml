item (FEAT_AIRCRAFT, Boeing_777X)
{
  property
  {
    name: string(STR_AIRV_BOEING_777X);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2020), 1, 25);
    vehicle_life: 30;
    model_life: get_model_life(2020,2050);
    retire_early: get_retire_early(2020,2050);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_LARGE;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 26;
    passenger_capacity: 426;
    mail_capacity: 43;
    acceleration: 27;                  // in 27,75 mph/day
    range: 3400;
    sound_effect: SOUND_TAKEOFF_JET_BIG;
  }
  graphics {
    default: Boeing_777X_sprites;
    purchase: Boeing_777X_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: Boeing_777X_cargo_subtype_text;
	passenger_capacity: Boeing_777X_cargo_subtype_capacity;
    speed: Boeing_777X_speed;
    running_cost_factor: Boeing_777X_running_cost_factor;
    sound_effect: Boeing_777X_sound_effect;

    cost_factor: 305; 
    purchase_running_cost_factor: 240;
    purchase_speed: plane_speed_kmh(905); 
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, Boeing_777X)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, Boeing_777X)
  {
    property
    { range: 3400; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, Boeing_777X)
  {
    property
    { range: 5100; }
  }
}
