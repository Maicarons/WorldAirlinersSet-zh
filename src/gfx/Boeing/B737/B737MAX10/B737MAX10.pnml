item (FEAT_AIRCRAFT, Boeing_737_MAX10)
{
  property
  {
    name: string(STR_AIRV_BOEING_737_MAX10);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2021), 5, 1);
    vehicle_life: 30;
    model_life: get_model_life(2021,2272);
    retire_early: get_retire_early(2021,2272);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 22;
    passenger_capacity: 230;
    mail_capacity: 23;
    acceleration: 27;                  // in 27,75 mph/day
    range: 1300;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: Boeing_737_MAX10_sprites;
    purchase: Boeing_737_MAX10_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: Boeing_737_MAX10_cargo_subtype_text;
	passenger_capacity: Boeing_737_MAX10_cargo_subtype_capacity;
    speed: Boeing_737_MAX10_speed;
    running_cost_factor: Boeing_737_MAX10_running_cost_factor;

    cost_factor: 112; 
    purchase_running_cost_factor: 76;
    purchase_speed: plane_speed_kmh(975); 
  }
}

