item (FEAT_AIRCRAFT, Boeing_787_10)
{
  property
  {
    name: string(STR_AIRV_BOEING_787_10);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2018), 3, 26);
    vehicle_life: 30;
    model_life: get_model_life(2018,2266);
    retire_early: get_retire_early(2018,2266);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_LARGE;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 42;
    passenger_capacity: 330;
    mail_capacity: 33;
    acceleration: 27;                  // in 27,75 mph/day
    range: 2400;
    sound_effect: SOUND_TAKEOFF_JET_BIG;
  }
  graphics {
    default: Boeing_787_10_sprites;
    purchase: Boeing_787_10_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: Boeing_787_10_cargo_subtype_text;
	passenger_capacity: Boeing_787_10_cargo_subtype_capacity;
    speed: Boeing_787_10_speed;
    running_cost_factor: Boeing_787_10_running_cost_factor;

    cost_factor: 230; 
    purchase_running_cost_factor: 175;
    purchase_speed: plane_speed_kmh(943); 
  }
}

