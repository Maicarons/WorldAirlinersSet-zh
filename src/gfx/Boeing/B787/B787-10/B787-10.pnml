switch (FEAT_AIRCRAFT, SELF, Boeing_787_10_running_cost_factor, flight_state())
{
  plane_RC(169)
}

switch (FEAT_AIRCRAFT, SELF, Boeing_787_10_speed, flight_state())
{
  12..13: return plane_speed_kmh(257); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(418); // airplane climbing after take-off
      18: return plane_speed_kmh(943); // heading for tower contact point
  16..20: return plane_speed_kmh(427); // in flight
  21..22: return plane_speed_kmh(257); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(201);
}

