switch (FEAT_AIRCRAFT, SELF, Embraer_E195_E2_running_cost_factor, flight_state())
{
  plane_RC(66)
}

switch (FEAT_AIRCRAFT, SELF, Embraer_E195_E2_speed, flight_state())
{
  12..13: return plane_speed_kmh(241); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(410); // airplane climbing after take-off
      18: return plane_speed_kmh(886); // heading for tower contact point
  16..20: return plane_speed_kmh(427); // in flight
  21..22: return plane_speed_kmh(273); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(201);
}

switch (FEAT_AIRCRAFT, SELF, Embraer_E195_E2_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;                          
}

switch (FEAT_AIRCRAFT, SELF, Embraer_E195_E2_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_EMBRAER);
  1: string(STR_VLIV_AIR_DOLOMITI);
  2: string(STR_VLIV_AIR_EUROPA);
  3: string(STR_VLIV_AIR_EUROPA_OLD);
  4: string(STR_VLIV_AUSTRIAN_AIRLINES);
  5: string(STR_VLIV_BELAVIA);
  6: string(STR_VLIV_FLYBE);
  7: string(STR_VLIV_GREAT_DANE);
  8: string(STR_VLIV_LOT);
  9: string(STR_VLIV_LUFTHANSA);
 10: string(STR_VLIV_MONTENEGRO_AIRLINES);
      return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, Embraer_E195_E2_cargo_subtype_capacity, cargo_subtype)
{
  1: return 146; // Air Dolomiti
  2: return 146; // Air Europa
  3: return 146; // Air Europa Old
  4: return 146; // Austrian
  5: return 146; // Belavia
  6: return 146; // Flybe
  7: return 146; // GreatDane
  8: return 146; // LOT
  9: return 146; // Lufthansa
 10: return 146; // Montenegro
     return 146;
}

item (FEAT_AIRCRAFT, Embraer_E195_E2)
{
  property
  {
    name: string(STR_AIRV_EMBRAER_E195_E2);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2019), 4, 15);
    vehicle_life: 26;
    model_life: get_model_life(2019,2259);
    retire_early: get_retire_early(2019,2259);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 18;
    passenger_capacity: 146;
    mail_capacity: 15;
    acceleration: 27;                  // in 27,75 mph/day
    range: 1050;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: Embraer_E195_E2_sprites;
    purchase: Embraer_E195_E2_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: Embraer_E195_E2_cargo_subtype_text;
	passenger_capacity: Embraer_E195_E2_cargo_subtype_capacity;
    speed: Embraer_E195_E2_speed;
    running_cost_factor: Embraer_E195_E2_running_cost_factor;
    sound_effect: Embraer_E195_E2_sound_effect;

    cost_factor: 44; 
    purchase_running_cost_factor: 69;
    purchase_speed: plane_speed_kmh(890); 
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, Embraer_E195_E2)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, Embraer_E195_E2)
