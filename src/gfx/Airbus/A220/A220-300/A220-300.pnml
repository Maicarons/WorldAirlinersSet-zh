item (FEAT_AIRCRAFT , Airbus_A220_300)
{
  property
  {
    name: string(STR_AIRV_AIRBUS_A220_300);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2016), 12, 21);
    vehicle_life: 26;
    model_life: get_model_life(2016,2050);
    retire_early: get_retire_early(2016,2050);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 22;
    passenger_capacity: 145;
    mail_capacity: 14;
    acceleration: 27;                  // in 27,75 mph/day
    range: 1090;
  }
  graphics {
    default: Airbus_A220_300_sprites;
    purchase: Airbus_A220_300_purchase_sprite;

    cargo_subtype_text: Airbus_A220_300_cargo_subtype_text;
	passenger_capacity: Airbus_A220_300_cargo_subtype_capacity;
    speed: Airbus_A220_300_speed;
    running_cost_factor: Airbus_A220_300_running_cost_factor;

    cost_factor: 92; 
    purchase_running_cost_factor: 66;
    purchase_speed: plane_speed_kmh(840); 
  }
}

