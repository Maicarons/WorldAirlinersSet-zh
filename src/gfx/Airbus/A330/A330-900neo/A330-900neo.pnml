item (FEAT_AIRCRAFT, Airbus_A330_900neo)
{
  property
  {
    name: string(STR_AIRV_AIRBUS_A330_900NEO);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2018), 11, 26);
    vehicle_life: 25;
    model_life: get_model_life(2018,2050);
    retire_early: get_retire_early(2018,2050);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_LARGE;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 43;
    passenger_capacity: 300;
    mail_capacity: 30;
    acceleration: 27;                  // in 27,75 mph/day
    range: 2600;
    sound_effect: SOUND_TAKEOFF_JET_BIG;
  }
  graphics {
    default: Airbus_A330_900neo_sprites;
    purchase: Airbus_A330_900neo_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: Airbus_A330_900neo_cargo_subtype_text;
	passenger_capacity: Airbus_A330_900neo_cargo_subtype_capacity;
    speed: Airbus_A330_900neo_speed;
    running_cost_factor: Airbus_A330_900neo_running_cost_factor;

    cost_factor: 190; 
    purchase_running_cost_factor: 168;
    purchase_speed: plane_speed_kmh(926); 
  }
}

